---
interface Props {
  sportsCount: number;
  landscapeCount: number;
  miscCount: number;
  eventsCount: number;
  hasJournalism: boolean;
  hasCommercial: boolean;
}

const { sportsCount, landscapeCount, miscCount, eventsCount, hasJournalism, hasCommercial } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// Only list sections that actually have content; number them sequentially.
const items = [
  { href: '#sports', name: 'Sports', count: pad(sportsCount), show: sportsCount > 0 },
  { href: '#landscape', name: 'Landscape', count: pad(landscapeCount), show: landscapeCount > 0 },
  { href: '#misc', name: 'Personal', count: pad(miscCount), show: miscCount > 0 },
  { href: '#events', name: 'Events', count: pad(eventsCount), show: eventsCount > 0 },
  { href: '#journalism', name: 'Journalism', count: 'Reel', show: hasJournalism },
  { href: '#commercial', name: 'Commercial', count: 'Spot', show: hasCommercial },
].filter((i) => i.show);
---
<section class="work-index" id="work" aria-labelledby="work-heading">
  <p class="section-eyebrow">001 / Index</p>
  <h2 class="visually-hidden" id="work-heading">Work</h2>
  <ol class="work-list" role="list">
    {items.map((item, i) => (
      <li><a href={item.href} class="work-link"><span class="work-num">{pad(i + 1)}</span><span class="work-name">{item.name}</span><span class="work-count">{item.count}</span></a></li>
    ))}
  </ol>
</section>
